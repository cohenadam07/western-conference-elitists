<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wcehoops.news</string>

  <!-- Reset a dedicated worktree to origin/main, then run the runner from it. The reset happens
       here, not inside run.sh, because a script must not be replaced while bash is reading it.
       The worktree is created on first run. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>R="$HOME/western-conference-elitists"; W="$R/.worktrees/news-bot"; grep -qx '.worktrees/' "$R/.git/info/exclude" || echo '.worktrees/' &gt;&gt; "$R/.git/info/exclude"; git -C "$R" fetch -q origin main || exit 1; [ -d "$W" ] || git -C "$R" worktree add -q --detach "$W" origin/main || exit 1; git -C "$W" checkout -q -f --detach origin/main &amp;&amp; git -C "$W" clean -fdq public/news.json; exec /bin/bash "$W/pipeline/news/run.sh"</string>
  </array>

  <!-- launchd starts with a minimal PATH; give git and python what they need. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Library/Frameworks/Python.framework/Versions/3.13/bin</string>
    <key>HOME</key>
    <string>/Users/adamcohen</string>
  </dict>

  <!-- Three runs a day: early morning, afternoon, and late evening after games. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/adamcohen/Library/Logs/wce-news/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/adamcohen/Library/Logs/wce-news/launchd.log</string>
</dict>
</plist>
