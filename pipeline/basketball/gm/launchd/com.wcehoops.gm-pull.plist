<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GM Savant's Mac lane (mac_pull.sh): this season's Basketball-Reference and NBA.com pages, parsed here and sent to
     the cloud as encrypted facts. 6:10am and 4:10pm Eastern, and when loaded.

     It runs from .worktrees/savant-bot, the clean checkout of main the other Mac jobs use, and does nothing (one log
     line) until GM Savant is on main there. It starts each run from the cloud's latest state (GM_SYNC_STATE=1).
     While ~/.config/wce/gm-br-hold or ~/.config/wce/contracts-br-hold exists, Basketball-Reference is read from the cache only (fetch.py).

     Every variable the job uses is set below, so it runs the same whatever the login shell has (launchd starts it
     with almost nothing). No secret is in this file (the repo is public): the state key and the Control Room key are
     files on this Mac, named here by path.

     Installed Nov 24 2026:
       cp pipeline/basketball/gm/launchd/com.wcehoops.gm-pull.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.wcehoops.gm-pull.plist
     To remove: launchctl bootout gui/$(id -u)/com.wcehoops.gm-pull -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wcehoops.gm-pull</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>S=/Users/adamcohen/western-conference-elitists/.worktrees/savant-bot/pipeline/basketball/gm/mac_pull.sh; if [ -f "$S" ]; then exec /bin/bash "$S"; else echo "$(date '+%Y-%m-%d %H:%M:%S') GM Savant is not on main in savant-bot yet: nothing to do"; fi</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/adamcohen/western-conference-elitists/.worktrees/savant-bot</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- tools: python3 (python.org 3.13), gh (Homebrew), openssl, git, rsync (system) -->
    <key>PATH</key><string>/Library/Frameworks/Python.framework/Versions/3.13/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>GM_PYTHON</key><string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
    <key>HOME</key><string>/Users/adamcohen</string>
    <key>USER</key><string>adamcohen</string>
    <key>LANG</key><string>en_US.UTF-8</string>
    <key>LC_ALL</key><string>en_US.UTF-8</string>
    <key>PYTHONIOENCODING</key><string>utf-8</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
    <!-- the season, the draft window and "today" are Eastern dates -->
    <key>TZ</key><string>America/New_York</string>
    <!-- where the fetched pages stay (they never leave this Mac) -->
    <key>GM_CACHE</key><string>/Users/adamcohen/Basketball-Savant/cache_gm</string>
    <key>GM_CACHE_BR</key><string>/Users/adamcohen/Basketball-Savant/cache_br</string>
    <!-- the parsed facts that are sent -->
    <key>GM_FACTS</key><string>/Users/adamcohen/western-conference-elitists/.worktrees/savant-bot/pipeline/basketball/gm/out/facts</string>
    <!-- start each run from the cloud's latest state bundle (mac_pull.sh) -->
    <key>GM_SYNC_STATE</key><string>1</string>
    <!-- secrets, by path only -->
    <key>GM_STATE_KEY_FILE</key><string>/Users/adamcohen/.config/wce/gm-state.key</string>
    <key>WCE_CONTROL_ROOM_ENV</key><string>/Users/adamcohen/.config/wce/control-room.env</string>
    <!-- gh: its login lives in ~/.config/gh; this names the repo the release and the workflow belong to -->
    <key>GH_REPO</key><string>cohenadam07/western-conference-elitists</string>
    <key>GH_PROMPT_DISABLED</key><string>1</string>
    <key>GH_NO_UPDATE_NOTIFIER</key><string>1</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>10</integer></dict>
  </array>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/adamcohen/Library/Logs/gm-pull.log</string>
  <key>StandardErrorPath</key><string>/Users/adamcohen/Library/Logs/gm-pull.log</string>
</dict>
</plist>
